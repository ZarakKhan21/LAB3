public interface Shape {
    void draw();
    double getCost();  // Added pricing
}

// Concrete Shapes
public class Rectangle implements Shape {
    private double price = 10.0;  // Base price

    @Override
    public void draw() {
        System.out.println("Shape: Rectangle");
    }

    @Override
    public double getCost() {
        return price;
    }
}

public class Circle implements Shape {
    private double price = 8.0;  // Base price

    @Override
    public void draw() {
        System.out.println("Shape: Circle");
    }

    @Override
    public double getCost() {
        return price;
    }
}

// Decorator (Abstract)
public abstract class ShapeDecorator implements Shape {
    protected Shape decoratedShape;

    public ShapeDecorator(Shape decoratedShape) {
        this.decoratedShape = decoratedShape;
    }

    @Override
    public void draw() {
        decoratedShape.draw();
    }

    @Override
    public double getCost() {
        return decoratedShape.getCost();
    }
}

// Concrete Decorator (Red Border)
public class RedShapeDecorator extends ShapeDecorator {
    private double decorationCost = 2.5;  // Additional cost

    public RedShapeDecorator(Shape decoratedShape) {
        super(decoratedShape);
    }

    @Override
    public void draw() {
        decoratedShape.draw();
        setRedBorder();
        System.out.println("Total Cost: $" + getCost());  // Show total
    }

    private void setRedBorder() {
        System.out.println("Border Color: Red (+$" + decorationCost + ")");
    }

    @Override
    public double getCost() {
        return super.getCost() + decorationCost;  // Sum costs
    }
}

// Demo
public class Main {
    public static void main(String[] args) {
        Shape circle = new Circle();
        Shape redCircle = new RedShapeDecorator(new Circle());

        System.out.println("Normal Circle:");
        circle.draw();  // Output: Shape: Circle | Cost: $8.0

        System.out.println("\nRed Circle:");
        redCircle.draw();  // Output: Shape: Circle | Border: Red (+$2.5) | Total: $10.5
    }
}
